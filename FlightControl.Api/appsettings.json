{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Issuer": "FlightControl",
    "Audience": "FlightControl.Api",
    "AccessTokenMinutes": 15
  },

  "RefreshToken": {
  "SlidingLifetimeDays": 7,
  "AbsoluteLifetimeDays": 30
  }
}
